{
  "name": "cloudru-jupyter-vscode",
  "displayName": "Cloud.ru ML Space Notebooks",
  "description": "Sign in to Cloud.ru, browse Jupyter Server notebooks created in the ML Space console, and open them.",
  "version": "0.0.1",
  "publisher": "cloudru",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Data Science",
    "Notebooks",
    "Machine Learning"
  ],
  "keywords": [
    "cloud.ru",
    "mlspace",
    "jupyter",
    "notebook",
    "remote"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cloud-ru/cloudru-jupyter-vscode"
  },
  "activationEvents": [
    "onView:cloudruNotebooks"
  ],
  "extensionDependencies": [
    "ms-toolsai.jupyter"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cloudru",
          "title": "Cloud.ru ML Space",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "cloudru": [
        {
          "id": "cloudruNotebooks",
          "name": "Notebooks",
          "icon": "media/activity-icon.svg",
          "contextualTitle": "Cloud.ru ML Space"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cloudruNotebooks",
        "contents": "Sign in to Cloud.ru to view the Jupyter Server notebooks created in the ML Space console.\n[Sign in to Cloud.ru](command:cloudru.signIn)",
        "when": "!cloudru.authenticated"
      },
      {
        "view": "cloudruNotebooks",
        "contents": "No workspace selected.\n[Select Workspace](command:cloudru.selectWorkspace)",
        "when": "cloudru.authenticated"
      }
    ],
    "commands": [
      {
        "command": "cloudru.signIn",
        "title": "Sign In",
        "category": "Cloud.ru",
        "icon": "$(sign-in)"
      },
      {
        "command": "cloudru.signOut",
        "title": "Sign Out",
        "category": "Cloud.ru",
        "icon": "$(sign-out)"
      },
      {
        "command": "cloudru.selectWorkspace",
        "title": "Select Workspace",
        "category": "Cloud.ru",
        "icon": "$(organization)"
      },
      {
        "command": "cloudru.refreshNotebooks",
        "title": "Refresh Notebooks",
        "category": "Cloud.ru",
        "icon": "$(refresh)"
      },
      {
        "command": "cloudru.openNotebook",
        "title": "Open in VS Code",
        "category": "Cloud.ru",
        "icon": "$(notebook)"
      },
      {
        "command": "cloudru.resumeNotebook",
        "title": "Start Notebook",
        "category": "Cloud.ru",
        "icon": "$(run)"
      },
      {
        "command": "cloudru.pauseNotebook",
        "title": "Pause Notebook",
        "category": "Cloud.ru",
        "icon": "$(debug-pause)"
      },
      {
        "command": "cloudru.openNotebookFiles",
        "title": "Browse Files (SSH)",
        "category": "Cloud.ru",
        "icon": "$(folder-opened)"
      },
      {
        "command": "cloudru.openFullIde",
        "title": "Open Full IDE (Remote-SSH)",
        "category": "Cloud.ru",
        "icon": "$(remote-explorer)"
      },
      {
        "command": "cloudru.configureSsh",
        "title": "Configure SSH (key & account)",
        "category": "Cloud.ru"
      },
      {
        "command": "cloudru.openNotebookInBrowser",
        "title": "Open in Browser",
        "category": "Cloud.ru",
        "icon": "$(link-external)"
      },
      {
        "command": "cloudru.searchNotebooks",
        "title": "Search by Name…",
        "category": "Cloud.ru",
        "icon": "$(search)"
      },
      {
        "command": "cloudru.filterByAuthor",
        "title": "Filter by Author…",
        "category": "Cloud.ru",
        "icon": "$(account)"
      },
      {
        "command": "cloudru.filterByStatus",
        "title": "Filter by Status…",
        "category": "Cloud.ru",
        "icon": "$(pulse)"
      },
      {
        "command": "cloudru.toggleFavoritesFilter",
        "title": "Show Favorites Only",
        "category": "Cloud.ru",
        "icon": "$(star)"
      },
      {
        "command": "cloudru.clearFilters",
        "title": "Clear Filters",
        "category": "Cloud.ru",
        "icon": "$(clear-all)"
      },
      {
        "command": "cloudru.addFavorite",
        "title": "Add to Favorites",
        "category": "Cloud.ru",
        "icon": "$(star-empty)"
      },
      {
        "command": "cloudru.removeFavorite",
        "title": "Remove from Favorites",
        "category": "Cloud.ru",
        "icon": "$(star-full)"
      }
    ],
    "submenus": [
      {
        "id": "cloudru.notebookActions",
        "label": "Notebook Actions",
        "icon": "$(ellipsis)"
      },
      {
        "id": "cloudru.filterMenu",
        "label": "Filter Notebooks",
        "icon": "$(filter)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cloudru.refreshNotebooks",
          "when": "view == cloudruNotebooks && cloudru.authenticated",
          "group": "navigation@1"
        },
        {
          "submenu": "cloudru.filterMenu",
          "when": "view == cloudruNotebooks && cloudru.authenticated",
          "group": "navigation@2"
        },
        {
          "command": "cloudru.selectWorkspace",
          "when": "view == cloudruNotebooks && cloudru.authenticated",
          "group": "overflow@1"
        },
        {
          "command": "cloudru.signOut",
          "when": "view == cloudruNotebooks && cloudru.authenticated",
          "group": "overflow@2"
        }
      ],
      "cloudru.filterMenu": [
        {
          "command": "cloudru.searchNotebooks",
          "when": "view == cloudruNotebooks",
          "group": "1_filter@1"
        },
        {
          "command": "cloudru.filterByAuthor",
          "when": "view == cloudruNotebooks",
          "group": "1_filter@2"
        },
        {
          "command": "cloudru.filterByStatus",
          "when": "view == cloudruNotebooks",
          "group": "1_filter@3"
        },
        {
          "command": "cloudru.toggleFavoritesFilter",
          "when": "view == cloudruNotebooks",
          "group": "1_filter@4"
        },
        {
          "command": "cloudru.clearFilters",
          "when": "view == cloudruNotebooks && cloudru.hasFilter",
          "group": "2_clear@1"
        }
      ],
      "view/item/context": [
        {
          "submenu": "cloudru.notebookActions",
          "when": "view == cloudruNotebooks && viewItem =~ /^notebook/",
          "group": "inline@1"
        }
      ],
      "cloudru.notebookActions": [
        {
          "command": "cloudru.openNotebook",
          "when": "view == cloudruNotebooks && viewItem =~ /^notebook\\.running/",
          "group": "1_open@1"
        },
        {
          "command": "cloudru.openNotebookInBrowser",
          "when": "view == cloudruNotebooks && viewItem =~ /^notebook/",
          "group": "1_open@2"
        },
        {
          "command": "cloudru.resumeNotebook",
          "when": "view == cloudruNotebooks && viewItem =~ /^notebook\\.paused/",
          "group": "2_lifecycle@1"
        },
        {
          "command": "cloudru.pauseNotebook",
          "when": "view == cloudruNotebooks && viewItem =~ /^notebook\\.running/",
          "group": "2_lifecycle@2"
        },
        {
          "command": "cloudru.openNotebookFiles",
          "when": "view == cloudruNotebooks && viewItem =~ /^notebook\\.running/",
          "group": "3_ssh@1"
        },
        {
          "command": "cloudru.openFullIde",
          "when": "view == cloudruNotebooks && viewItem =~ /^notebook\\.running/",
          "group": "3_ssh@2"
        },
        {
          "command": "cloudru.addFavorite",
          "when": "view == cloudruNotebooks && viewItem =~ /^notebook/ && !(viewItem =~ /\\.fav$/)",
          "group": "4_favorites@1"
        },
        {
          "command": "cloudru.removeFavorite",
          "when": "view == cloudruNotebooks && viewItem =~ /\\.fav$/",
          "group": "4_favorites@1"
        }
      ]
    },
    "configuration": {
      "title": "Cloud.ru ML Space",
      "properties": {
        "cloudru.console.apiBaseUrl": {
          "type": "string",
          "default": "https://console.cloud.ru/aicloud/ui",
          "description": "Base URL of the Cloud.ru console UI backend used for the notebooks list."
        },
        "cloudru.console.url": {
          "type": "string",
          "default": "https://console.cloud.ru/",
          "description": "Console URL opened in the sign-in browser window to capture the session token."
        },
        "cloudru.notebook.chromePath": {
          "type": "string",
          "default": "",
          "description": "Path to a Chrome/Chromium/Edge executable used for the one-time notebook sign-in. Leave empty to auto-detect."
        },
        "cloudru.ssh.privateKeyPath": {
          "type": "string",
          "default": "",
          "description": "Path to the ML Space SSH private key (downloaded from the console SSH dialog). Used to browse notebook files over SFTP."
        },
        "cloudru.ssh.host": {
          "type": "string",
          "default": "ssh-jupyter.ai.cloud.ru",
          "description": "Default SSH gateway host, used only when you enter just an account id. Normally the host (and port) are taken verbatim from the connection command you paste from the console SSH dialog — it is region-dependent, e.g. ssh-jupyter.ai.cloud.ru or ssh-<region>-jupyter.ai.cloud.ru."
        },
        "cloudru.ssh.port": {
          "type": "number",
          "default": 2222,
          "description": "SSH gateway port."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle": "node esbuild.js",
    "bundle:watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "typecheck": "tsc --noEmit -p ./",
    "test": "vitest run"
  },
  "dependencies": {
    "http-proxy": "^1.18.1",
    "puppeteer-core": "^22.15.0",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.14",
    "@types/node": "^20.14.0",
    "@types/ssh2": "^1.15.0",
    "@types/vscode": "^1.90.0",
    "@vscode/jupyter-extension": "^1.1.1",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

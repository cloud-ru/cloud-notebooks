{
  "name": "cloudru-jupyter-vscode",
  "displayName": "Cloud.ru Distributed Train Notebooks",
  "description": "Sign in to Cloud.ru, browse Jupyter Server notebooks created in the Distributed Train console, and open them.",
  "version": "0.1.2",
  "publisher": "cloudru",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Data Science",
    "Notebooks",
    "Machine Learning"
  ],
  "keywords": [
    "cloud.ru",
    "distributed train",
    "jupyter",
    "notebook",
    "remote"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cloud-ru/cloud-notebooks.git"
  },
  "homepage": "https://github.com/cloud-ru/cloud-notebooks#readme",
  "bugs": {
    "url": "https://github.com/cloud-ru/cloud-notebooks/issues"
  },
  "activationEvents": [
    "onView:cloudruNotebooks"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cloudru",
          "title": "Cloud.ru Distributed Train",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "cloudru": [
        {
          "id": "cloudruNotebooks",
          "name": "Notebooks",
          "icon": "media/activity-icon.svg",
          "contextualTitle": "Cloud.ru Distributed Train"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cloudruNotebooks",
        "contents": "Войдите в Cloud.ru, чтобы увидеть Jupyter Server из консоли Distributed Train.\n[Войти в Cloud.ru](command:cloudru.signIn)",
        "when": "!cloudru.authenticated && !cloudru.sessionExpired"
      },
      {
        "view": "cloudruNotebooks",
        "contents": "Сессия Cloud.ru истекла. Войдите снова, чтобы продолжить.\n[Войти в Cloud.ru](command:cloudru.signIn)",
        "when": "!cloudru.authenticated && cloudru.sessionExpired"
      },
      {
        "view": "cloudruNotebooks",
        "contents": "Воркспейс не выбран.\n[Выбрать воркспейс](command:cloudru.selectWorkspace)",
        "when": "cloudru.authenticated && !cloudru.workspaceSelected"
      },
      {
        "view": "cloudruNotebooks",
        "contents": "Не удалось загрузить ноутбуки.\n[Повторить](command:cloudru.refreshNotebooks)",
        "when": "cloudru.authenticated && cloudru.workspaceSelected && cloudru.loadError"
      },
      {
        "view": "cloudruNotebooks",
        "contents": "Загружаем ноутбуки…",
        "when": "cloudru.authenticated && cloudru.workspaceSelected && cloudru.loading"
      },
      {
        "view": "cloudruNotebooks",
        "contents": "Ничего не найдено по текущему фильтру.\n[Сбросить фильтры](command:cloudru.clearFilters)",
        "when": "cloudru.authenticated && cloudru.workspaceSelected && cloudru.filteredEmpty"
      },
      {
        "view": "cloudruNotebooks",
        "contents": "В выбранном воркспейсе нет ноутбуков.\n[Создать в консоли](command:cloudru.createNotebookInConsole)\n[Обновить](command:cloudru.refreshNotebooks)",
        "when": "cloudru.authenticated && cloudru.workspaceSelected && !cloudru.loadError && !cloudru.loading && !cloudru.hasFilter"
      }
    ],
    "commands": [
      { "command": "cloudru.signIn", "title": "Войти", "category": "Cloud.ru", "icon": "$(sign-in)" },
      { "command": "cloudru.signOut", "title": "Выйти", "category": "Cloud.ru" },
      { "command": "cloudru.selectWorkspace", "title": "Выбрать воркспейс", "category": "Cloud.ru" },
      {
        "command": "cloudru.refreshNotebooks",
        "title": "Обновить список",
        "category": "Cloud.ru",
        "icon": "$(refresh)"
      },
      { "command": "cloudru.openNotebook", "title": "Открыть в VS Code", "category": "Cloud.ru" },
      { "command": "cloudru.resumeNotebook", "title": "Запустить", "category": "Cloud.ru" },
      { "command": "cloudru.pauseNotebook", "title": "Остановить", "category": "Cloud.ru" },
      { "command": "cloudru.openNotebookFiles", "title": "Файлы по SSH", "category": "Cloud.ru" },
      { "command": "cloudru.openFullIde", "title": "Полный IDE (Remote-SSH)", "category": "Cloud.ru" },
      { "command": "cloudru.configureSsh", "title": "Настроить SSH (ключ и аккаунт)", "category": "Cloud.ru" },
      {
        "command": "cloudru.generateSshKey",
        "title": "Получить SSH-ключ (сгенерировать новый)",
        "category": "Cloud.ru"
      },
      {
        "command": "cloudru.uploadSshKey",
        "title": "Загрузить свой публичный SSH-ключ…",
        "category": "Cloud.ru"
      },
      { "command": "cloudru.openNotebookInBrowser", "title": "Открыть в браузере", "category": "Cloud.ru" },
      { "command": "cloudru.showLogs", "title": "Показать логи", "category": "Cloud.ru" },
      { "command": "cloudru.downloadLogs", "title": "Скачать логи…", "category": "Cloud.ru" },
      { "command": "cloudru.editDescription", "title": "Изменить описание…", "category": "Cloud.ru" },
      { "command": "cloudru.deleteNotebook", "title": "Удалить…", "category": "Cloud.ru" },
      { "command": "cloudru.openMonitoring", "title": "Открыть консоль (мониторинг)", "category": "Cloud.ru" },
      {
        "command": "cloudru.createNotebookInConsole",
        "title": "Открыть консоль для создания Jupyter Server…",
        "category": "Cloud.ru"
      },
      { "command": "cloudru.notebookActions", "title": "Действия с ноутбуком…", "category": "Cloud.ru" },
      { "command": "cloudru.statusBarMenu", "title": "Меню строки состояния", "category": "Cloud.ru" },
      { "command": "cloudru.searchNotebooks", "title": "Поиск по имени…", "category": "Cloud.ru" },
      { "command": "cloudru.filterByAuthor", "title": "Фильтр по автору…", "category": "Cloud.ru" },
      { "command": "cloudru.filterByStatus", "title": "Фильтр по статусу…", "category": "Cloud.ru" },
      { "command": "cloudru.toggleFavoritesFilter", "title": "Только избранные", "category": "Cloud.ru" },
      { "command": "cloudru.clearFilters", "title": "Сбросить фильтры", "category": "Cloud.ru" },
      { "command": "cloudru.addFavorite", "title": "В избранное", "category": "Cloud.ru" },
      { "command": "cloudru.removeFavorite", "title": "Убрать из избранного", "category": "Cloud.ru" }
    ],
    "submenus": [
      { "id": "cloudru.notebookActionsMenu", "label": "Действия", "icon": "$(ellipsis)" },
      { "id": "cloudru.filterMenu", "label": "Фильтр", "icon": "$(filter)" }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cloudru.signIn",
          "when": "view == cloudruNotebooks && !cloudru.authenticated",
          "group": "navigation@1"
        },
        {
          "command": "cloudru.refreshNotebooks",
          "when": "view == cloudruNotebooks && cloudru.authenticated",
          "group": "navigation@1"
        },
        {
          "submenu": "cloudru.filterMenu",
          "when": "view == cloudruNotebooks && cloudru.authenticated",
          "group": "navigation@2"
        },
        {
          "command": "cloudru.selectWorkspace",
          "when": "view == cloudruNotebooks && cloudru.authenticated",
          "group": "overflow@1"
        },
        {
          "command": "cloudru.createNotebookInConsole",
          "when": "view == cloudruNotebooks && cloudru.authenticated",
          "group": "overflow@2"
        },
        {
          "command": "cloudru.configureSsh",
          "when": "view == cloudruNotebooks && cloudru.authenticated",
          "group": "overflow@3"
        },
        {
          "command": "cloudru.generateSshKey",
          "when": "view == cloudruNotebooks && cloudru.authenticated",
          "group": "overflow@4"
        },
        {
          "command": "cloudru.uploadSshKey",
          "when": "view == cloudruNotebooks && cloudru.authenticated",
          "group": "overflow@5"
        },
        {
          "command": "cloudru.signOut",
          "when": "view == cloudruNotebooks && cloudru.authenticated",
          "group": "overflow@6"
        }
      ],
      "cloudru.filterMenu": [
        { "command": "cloudru.searchNotebooks", "when": "view == cloudruNotebooks", "group": "1_filter@1" },
        { "command": "cloudru.filterByAuthor", "when": "view == cloudruNotebooks", "group": "1_filter@2" },
        { "command": "cloudru.filterByStatus", "when": "view == cloudruNotebooks", "group": "1_filter@3" },
        { "command": "cloudru.toggleFavoritesFilter", "when": "view == cloudruNotebooks", "group": "1_filter@4" },
        {
          "command": "cloudru.clearFilters",
          "when": "view == cloudruNotebooks && cloudru.hasFilter",
          "group": "2_clear@1"
        }
      ],
      "view/item/context": [
        {
          "submenu": "cloudru.notebookActionsMenu",
          "when": "view == cloudruNotebooks && viewItem =~ /^notebook/",
          "group": "inline@1"
        }
      ],
      "cloudru.notebookActionsMenu": [
        {
          "command": "cloudru.openNotebook",
          "when": "view == cloudruNotebooks && viewItem =~ /^notebook\\.running/ && !(viewItem =~ /\\.denied/) && !(viewItem =~ /\\.noUrl/)",
          "group": "1_open@1"
        },
        {
          "command": "cloudru.openNotebookInBrowser",
          "when": "view == cloudruNotebooks && viewItem =~ /^notebook\\.running/ && !(viewItem =~ /\\.denied/) && !(viewItem =~ /\\.noUrl/)",
          "group": "1_open@2"
        },
        {
          "command": "cloudru.resumeNotebook",
          "when": "view == cloudruNotebooks && viewItem =~ /^notebook\\.paused/ && !(viewItem =~ /\\.denied/)",
          "group": "2_lifecycle@1"
        },
        {
          "command": "cloudru.pauseNotebook",
          "when": "view == cloudruNotebooks && viewItem =~ /^notebook\\.running/ && !(viewItem =~ /\\.denied/)",
          "group": "2_lifecycle@2"
        },
        {
          "command": "cloudru.deleteNotebook",
          "when": "view == cloudruNotebooks && (viewItem =~ /^notebook\\.running/ || viewItem =~ /^notebook\\.paused/ || viewItem =~ /^notebook\\.other/) && !(viewItem =~ /\\.denied/) && !(viewItem =~ /\\.deleted/)",
          "group": "2_lifecycle@3"
        },
        {
          "command": "cloudru.openNotebookFiles",
          "when": "view == cloudruNotebooks && viewItem =~ /^notebook\\.running/ && !(viewItem =~ /\\.denied/) && !(viewItem =~ /\\.noUrl/)",
          "group": "3_ssh@1"
        },
        {
          "command": "cloudru.openFullIde",
          "when": "view == cloudruNotebooks && viewItem =~ /^notebook\\.running/ && !(viewItem =~ /\\.denied/) && !(viewItem =~ /\\.noUrl/)",
          "group": "3_ssh@2"
        },
        {
          "command": "cloudru.showLogs",
          "when": "view == cloudruNotebooks && (viewItem =~ /^notebook\\.running/ || viewItem =~ /^notebook\\.other/) && !(viewItem =~ /\\.denied/) && !(viewItem =~ /\\.deleted/)",
          "group": "4_diag@1"
        },
        {
          "command": "cloudru.downloadLogs",
          "when": "view == cloudruNotebooks && (viewItem =~ /^notebook\\.running/ || viewItem =~ /^notebook\\.other/) && !(viewItem =~ /\\.denied/) && !(viewItem =~ /\\.deleted/)",
          "group": "4_diag@2"
        },
        {
          "command": "cloudru.openMonitoring",
          "when": "view == cloudruNotebooks && (viewItem =~ /^notebook\\.running/ || viewItem =~ /^notebook\\.paused/) && !(viewItem =~ /\\.dgx2/)",
          "group": "4_diag@3"
        },
        {
          "command": "cloudru.editDescription",
          "when": "view == cloudruNotebooks && (viewItem =~ /^notebook\\.running/ || viewItem =~ /^notebook\\.paused/ || viewItem =~ /^notebook\\.other/) && !(viewItem =~ /\\.denied/) && !(viewItem =~ /\\.deleted/)",
          "group": "6_meta@1"
        },
        {
          "command": "cloudru.addFavorite",
          "when": "view == cloudruNotebooks && viewItem =~ /^notebook/ && !(viewItem =~ /\\.fav$/)",
          "group": "5_favorites@1"
        },
        {
          "command": "cloudru.removeFavorite",
          "when": "view == cloudruNotebooks && viewItem =~ /\\.fav$/",
          "group": "5_favorites@1"
        }
      ],
      "commandPalette": [
        {
          "command": "cloudru.statusBarMenu",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Cloud.ru Distributed Train",
      "properties": {
        "cloudru.console.apiBaseUrl": {
          "scope": "application",
          "type": "string",
          "default": "https://console.cloud.ru/aicloud/ui",
          "description": "Base URL of the Cloud.ru console UI backend used for the notebooks list."
        },
        "cloudru.console.url": {
          "scope": "application",
          "type": "string",
          "default": "https://console.cloud.ru/",
          "description": "Console URL opened in the sign-in browser window to capture the session token."
        },
        "cloudru.console.keepSessionAlive": {
          "scope": "application",
          "type": "boolean",
          "default": true,
          "description": "Refresh the Cloud.ru session in the background (a short headless browser run each time the console token expires, every few minutes) so it does not time out while VS Code is open, even when the window is not focused. Pauses after 8 hours without activity in VS Code, so an unattended machine still times out. When disabled, the token is refreshed only when a request needs it."
        },
        "cloudru.notebook.chromePath": {
          "scope": "application",
          "type": "string",
          "default": "",
          "description": "Path to a Chrome/Chromium/Edge executable used for the one-time notebook sign-in. Leave empty to auto-detect."
        },
        "cloudru.ssh.privateKeyPath": {
          "scope": "application",
          "type": "string",
          "default": "",
          "description": "Path to the Distributed Train SSH private key (downloaded from the console SSH dialog). Used to browse notebook files over SFTP."
        },
        "cloudru.ssh.host": {
          "scope": "application",
          "type": "string",
          "default": "ssh-jupyter.ai.cloud.ru",
          "description": "Default SSH gateway host, used only when you enter just an account id. Normally the host (and port) are taken verbatim from the connection command you paste from the console SSH dialog — it is region-dependent, e.g. ssh-jupyter.ai.cloud.ru or ssh-<region>-jupyter.ai.cloud.ru."
        },
        "cloudru.ssh.port": {
          "scope": "application",
          "type": "number",
          "default": 2222,
          "description": "SSH gateway port."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle": "node esbuild.js",
    "bundle:watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "typecheck": "tsc --noEmit -p ./",
    "test": "vitest run"
  },
  "dependencies": {
    "http-proxy": "^1.18.1",
    "puppeteer-core": "^22.15.0",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.14",
    "@types/node": "^20.14.0",
    "@types/ssh2": "^1.15.0",
    "@types/vscode": "^1.90.0",
    "@vscode/jupyter-extension": "^1.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
